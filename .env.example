# EXAMPLE ONLY — never put real API keys in source control.
# Copy to .env (git-ignored) or configure via the app's Settings page (recommended:
# the key is stored in the Windows credential vault through DPAPI, not here).

AI_REPEAT_MODEL_PROVIDER=zai
AI_REPEAT_MODEL_ID=glm-5.3-flash
AI_REPEAT_ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Local dev only — prefer storing the key via Settings UI (DPAPI vault).
# AI_REPEAT_DEV_KEY=

AI_REPEAT_DEV_MODE=true
AI_REPEAT_DATA_DIR=./.local-dev
AI_REPEAT_AGENT_PORT=8757
AI_REPEAT_ALLOWED_DOMAINS=localhost,127.0.0.1
AI_REPEAT_MAX_STEPS_PER_RUN=30
AI_REPEAT_MAX_TOKENS_PER_RUN=50000
AI_REPEAT_AUTO_SCREENSHOT=false
AI_REPEAT_VOICE_ENABLED=false
